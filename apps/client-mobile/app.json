{
  "expo": {
    "name": "CrediFresh",
    "owner": "credifresh",
    "slug": "credifresh-iphone",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "credifresh",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.credifresh.client",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.credifresh.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#101F4D"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "c8c61fc9-6a8f-4173-ac7d-962987d3a22c"
      }
    }
  }
}
